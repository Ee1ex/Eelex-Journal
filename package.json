{
  "name": "eelex-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
